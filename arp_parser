import tkinter as tk
from tkinter import ttk, messagebox
import subprocess
import platform
import re

def parse_arp_cache():
    # Clear existing data in the table
    for item in tree.get_children():
        tree.delete(item)
        
    btn_scan.config(state=tk.DISABLED)
    lbl_status.config(text="Querying system ARP table...", fg="#e67e22")
    root.update()

    try:
        # Hide console window on Windows
        startupinfo = None
        if platform.system().lower() == 'windows':
            startupinfo = subprocess.STARTUPINFO()
            startupinfo.dwFlags |= subprocess.STARTF_USESHOWWINDOW
            
        # Execute the native ARP command
        output = subprocess.check_output(['arp', '-a'], startupinfo=startupinfo, universal_newlines=True)
        
        # Regex patterns to identify valid IPs and MACs
        ip_pattern = re.compile(r'\b(?:\d{1,3}\.){3}\d{1,3}\b')
        mac_pattern = re.compile(r'(?:[0-9a-fA-F]{2}[:-]){5}[0-9a-fA-F]{2}')
        
        count = 0
        for line in output.split('\n'):
            ip_match = ip_pattern.search(line)
            mac_match = mac_pattern.search(line)
            
            if ip_match and mac_match:
                ip_addr = ip_match.group(0)
                mac_addr = mac_match.group(0).replace('-', ':').lower() # Normalize MAC format
                
                # Determine allocation type (static vs dynamic)
                alloc_type = "Dynamic"
                if "static" in line.lower() or "perm" in line.lower():
                    alloc_type = "Static"
                elif ip_addr.endswith('.255') or ip_addr.startswith('224.'):
                    alloc_type = "Broadcast/Multicast"
                    
                tree.insert("", tk.END, values=(ip_addr, mac_addr, alloc_type))
                count += 1
                
        lbl_status.config(text=f"Completed: {count} ARP entries found.", fg="#27ae60")

    except Exception as e:
        messagebox.showerror("Execution Error", f"Failed to retrieve ARP table:\n{str(e)}")
        lbl_status.config(text="Scan Failed", fg="#c0392b")
        
    finally:
        btn_scan.config(state=tk.NORMAL)

# --- Tkinter GUI Layout ---
root = tk.Tk()
root.title("NOC Toolkit - Local ARP Cache Parser")
root.geometry("550x450")
root.resizable(False, False)

frame = ttk.Frame(root, padding="15")
frame.pack(fill=tk.BOTH, expand=True)

lbl_title = tk.Label(frame, text="Layer 2 ARP Table Analyzer", font=("Helvetica", 13, "bold"))
lbl_title.pack(anchor="w", pady=(0, 5))

lbl_desc = tk.Label(frame, text="Maps local IPv4 addresses to physical MAC hardware addresses.", font=("Helvetica", 9), fg="#555")
lbl_desc.pack(anchor="w", pady=(0, 15))

# Controls
control_frame = tk.Frame(frame)
control_frame.pack(fill=tk.X, pady=(0, 10))

btn_scan = tk.Button(control_frame, text="Fetch ARP Cache", command=parse_arp_cache, bg="#2980b9", fg="white", font=("Helvetica", 9, "bold"), width=18)
btn_scan.pack(side=tk.LEFT)

lbl_status = tk.Label(control_frame, text="Ready", font=("Helvetica", 9, "bold"), fg="#7f8c8d")
lbl_status.pack(side=tk.RIGHT, padx=(0, 5))

# Treeview Table (Spreadsheet style)
columns = ("ip", "mac", "type")
tree = ttk.Treeview(frame, columns=columns, show="headings", height=12)

# Define Headings
tree.heading("ip", text="IPv4 Address")
tree.heading("mac", text="Physical MAC Address")
tree.heading("type", text="Allocation Type")

# Define Columns styling
tree.column("ip", width=150, anchor="center")
tree.column("mac", width=170, anchor="center")
tree.column("type", width=150, anchor="center")

tree.pack(fill=tk.BOTH, expand=True, pady=(5, 0))

# Scrollbar for the table
scrollbar = ttk.Scrollbar(tree, orient=tk.VERTICAL, command=tree.yview)
tree.configure(yscroll=scrollbar.set)
scrollbar.pack(side=tk.RIGHT, fill=tk.Y)

root.mainloop()